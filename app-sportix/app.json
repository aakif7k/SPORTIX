{
  "expo": {
    "name": "SPORTiX",
    "slug": "app-sportix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "sportix",
    "splash": {
      "backgroundColor": "#060606"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sportix.app"
    },
    "android": {
      "package": "com.sportix.app",
      "adaptiveIcon": {
        "backgroundColor": "#060606",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow SPORTiX to use Face ID for secure access."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SPORTiX to access your photos to set your avatar and share media.",
          "cameraPermission": "Allow SPORTiX to use your camera to capture moments."
        }
      ]
    ]
  }
}
