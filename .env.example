# ─────────────────────────────────────────────────────────────────────────────
# SPORTiX — frontend (Vite) environment template
#
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# WARNING: every VITE_-prefixed variable is inlined into the client bundle at
# build time and is therefore PUBLIC. Never put a server secret here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Appwrite (browser SDK) ───────────────────────────────────────────────────
# Used only for the auth session (account.*) and read-only realtime subscriptions.
# The project ID is public by design; the browser SDK holds no API key.
VITE_APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id
VITE_APPWRITE_DATABASE_ID=your_appwrite_database_id
VITE_APPWRITE_STORAGE_BUCKET_ID=your_appwrite_images_bucket_id

# ── Backend API ──────────────────────────────────────────────────────────────
# All data reads and writes go through FastAPI, not the browser SDK.
VITE_API_URL=http://localhost:8000

# ── Google Gemini ────────────────────────────────────────────────────────────
# There is deliberately no AI variable here.
#
# AI calls are proxied through FastAPI (/api/ai), and the key lives only in
# GEMINI_API_KEY in sportix-backend/.env. VITE_GEMINI_API_KEY was removed from the
# codebase entirely: the two services that read it are deleted, so a value set here
# would do nothing except sit in your shell history.
